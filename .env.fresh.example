# Copy to .env.fresh on a new GB10. Values are host paths, not paths inside a
# container. Do not put registry passwords or model tokens in this file.
H3_STUDIO_ROOT=/opt/h3-studio
H3_STUDIO_MODELS_DIR=/opt/h3-studio/models
H3_STUDIO_RUNTIME_DIR=/opt/h3-studio/runtime
H3_STUDIO_DATA_DIR=/opt/h3-studio/data

# Private GHCR images pinned to the audited GB10 release. Log in with a token
# that can read packages before pull. Change these only as an explicit upgrade.
H3_STUDIO_APP_IMAGE=ghcr.io/xiaofei-fei/h3-studio-gb10/app@sha256:d58c07b412a30f154c4c9a740697ae789c3d2be2af13fe29c0120a18ab801ea5
H3_STUDIO_COMFY_IMAGE=ghcr.io/xiaofei-fei/h3-studio-gb10/comfy-runtime@sha256:7d004a5c96c250d279ab4c227ca92f3af8a4699444d4d6dfa1e01f5b2c323609

# The published runtime uses its fixed non-root service account internally.
H3_STUDIO_COMFY_PORT=8188
H3_STUDIO_APP_PORT=5174
