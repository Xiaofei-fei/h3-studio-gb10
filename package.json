{
  "name": "h3-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"env TMPDIR=/tmp tsx watch server/index.ts\" \"vite\"",
    "build": "npm run check && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "deploy:gb10": "node scripts/deploy-gb10.mjs",
    "preflight:portable": "node scripts/preflight-portable.mjs",
    "start": "env TMPDIR=/tmp tsx server/index.ts",
    "start:prod": "node server-dist/server/index.js",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "check": "tsc --noEmit",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
